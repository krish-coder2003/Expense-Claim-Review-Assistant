# Application Configuration & Environment Variables
# Copy this file to .env for local development

# Base Application Setup
VITE_APP_TITLE="PolicyGuard Expense Reviewer"
VITE_BASE_CURRENCY="USD"

# AI Engine Options
VITE_ENABLE_AI_SIMULATION="true"

# Optional External Services (Leave blank or add key if integrating real external API)
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
